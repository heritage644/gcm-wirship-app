    "test:sequencer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-sequencer.mjs",
    "test:sampler": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-sampler.mjs",
    "test:fades": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-fades.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
